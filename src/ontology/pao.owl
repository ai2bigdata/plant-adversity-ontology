    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PAO_3103000">
        <rdfs:label xml:lang="en">jasmonic acid treatment</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PAO_3100000"/>
    </owl:Class>

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PAO_3200000">
        <rdfs:label xml:lang="en">elicitor treatment</rdfs:label>
