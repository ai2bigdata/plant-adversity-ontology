    </owl:Class>

    <!-- ====================== FACETS (Annotation Properties) ====================== -->
    <owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/PAO_severity">
        <rdfs:label>severity</rdfs:label>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Allowed values: mild, moderate, severe, extreme</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/PAO_duration">
        <rdfs:label>duration</rdfs:label>
        <rdfs:comment>Allowed values: acute, chronic, intermittent</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/PAO_combination">
        <rdfs:label>stress combination</rdfs:label>
        <rdfs:comment>e.g., heat+drought, salt+drought</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/PAO_experimental_setup">
        <rdfs:label>experimental setup</rdfs:label>
        <rdfs:comment>e.g., field, greenhouse, growth chamber, PEG-simulated</rdfs:comment>
    </owl:AnnotationProperty>

</rdf:RDF>
